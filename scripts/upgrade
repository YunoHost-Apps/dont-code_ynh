#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICES
#=================================================
ynh_script_progression "Stopping systemd services..."

# Stop current services
for service_name in "${SERVICES_LIST[@]}"; do
    ynh_systemctl --service="${app}-${service_name}" --action="stop" || true
done

# Legacy services from pre-full-suite versions
for legacy_service in ide preview; do
    if ynh_hide_warnings yunohost service status "${app}-${legacy_service}" >/dev/null 2>&1; then
        ynh_systemctl --service="${app}-${legacy_service}" --action="stop" || true
        yunohost service remove "${app}-${legacy_service}" || true
    fi
    if [ -f "/etc/systemd/system/${app}-${legacy_service}.service" ]; then
        ynh_config_remove_systemd "${app}-${legacy_service}" || true
    fi
done

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# Missing settings ?
if [ -z "${public_key+x}" ]; then
    public_key=""
    ynh_app_setting_set --key=public_key --value="$public_key"
fi

# Set default tenant to empty if needed
if [ -z "${tenant+x}" ]; then
    tenant=""
    ynh_app_setting_set --key=tenant --value="$tenant"
fi

# The .env needs db_password
new_db_pwd=$(ynh_string_random) # Generate a random password
db_pwd="${db_pwd:-$new_db_pwd}"

if [[ -n "${document_path:-}" ]]; then
    # Renamed setting key
    document_dir="$document_path"
    ynh_app_setting_delete --key=document_path
    ynh_app_setting_set --key=document_dir --value="$document_dir"
fi

if [[ -n "${html_path:-}" ]]; then
    # document dir has moved from html_path to data_dir, so set the variable accordingly
    if [[ ${document_dir} == ${html_path}* ]]; then
        document_dir=$data_dir/docs
        ynh_app_setting_set --key=document_dir --value="$document_dir"
    fi

    # Migrate html_path to data_dir
    if [ -d "$html_path/docs" ]; then
        mkdir -p "$data_dir"
        mv "$html_path/docs" "$data_dir/"
    fi
    if [ -f "$html_path/index.html" ]; then
        mkdir -p "$data_dir"
        mv "$html_path/index.html" "$data_dir/" || true
    fi
    old_doc_dir="$html_path/docs"
    ynh_safe_rm "$html_path"
    ynh_app_setting_delete --key=html_path

    chmod -R o-rwx,gu+rwx "$data_dir"
    chown -R "$app:www-data" "$data_dir"

    # Update the path in .env file
    if [ -f "$install_dir/.env" ]; then
        ynh_backup_if_checksum_is_different "$install_dir/.env"
        ynh_replace --match="$old_doc_dir" --replace="$document_dir" --file="$install_dir/.env"
        ynh_store_file_checksum "$install_dir/.env"
    fi
fi

# Recalculate the document_url
correct_document_url=$(append_uri "https://${domain}${path}" "docs")
if [ "$correct_document_url" != "${document_url:-}" ]; then
    ynh_script_progression "Updating url for documents"
    document_url=$correct_document_url
    ynh_app_setting_set --key=document_url --value="$document_url"
fi

# Ensure document_dir setting exists
if [ -z "${document_dir:-}" ]; then
    document_dir=$data_dir/docs
    ynh_app_setting_set --key=document_dir --value="$document_dir"
fi

# Missing mistral API key
if [ -z "${mistral_key+x}" ]; then
    mistral_key="NONE"
    ynh_app_setting_set --key=mistral_key --value="$mistral_key"
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

ynh_setup_source --dest_dir="$install_dir" --full_replace --keep ".ssh/authorized_keys restart-services.sh"

#=================================================
# CONFIGURE DATA STORAGE
#=================================================
ynh_script_progression "Configuring data storage..."

# Move the web pages out of install_dir into data_dir (older installs kept
# them next to the services) so nginx can deliver them.
deploy_web_files

test_dir=$data_dir/test
ynh_app_setting_set --key=test_dir --value="$test_dir"
mkdir -p "$test_dir"
ynh_config_add --template="index.html" --destination="$test_dir/index.html"

mkdir -p "$document_dir"
chmod -R o-rwx,gu+rwx "$data_dir"
chown -R "$app:www-data" "$data_dir"

#=================================================
# UPDATE CONFIGURATION
#=================================================
ynh_script_progression "Updating $app's configuration..."

# Always update .env
ynh_config_add --template=".env" --destination="$install_dir/.env"

# Render dashboard and host runtime configuration for this YunoHost domain/path.
render_dashboard_config
render_host_config
patch_web_base_href

#=================================================
# ADD SSH ACCESS
#=================================================

_configure_ssh_access

#=================================================
# UPGRADE SUPPORTING TOOLS
#=================================================
ynh_script_progression "Upgrading Java..."

_install_java

ynh_script_progression "Upgrading MongoDB..."

ynh_install_mongo

# Ensure DB users/rights
for db_name in "${MONGO_DB_LIST[@]}"; do
    ynh_mongo_setup_db --db_user="$db_user" --db_pwd="$db_pwd" --db_name="dontCode$tenant${db_name}"
done

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx
if [ "$path" = "/" ]; then
    sed -i "s|location //|location /|g; s|__PATH__/|/|g; s|__PATH__|/|g" "/etc/nginx/conf.d/$domain.d/$app.conf"
fi

ynh_config_add_logrotate

for i in "${!SERVICES_LIST[@]}"; do
    service_name="${SERVICES_LIST[i]}"
    port="${PORT_LIST[i]}"
    ynh_config_add_systemd --service="${app}-${service_name}"
    yunohost service add "${app}-${service_name}" --description="Dont-code platform ${service_name} service" --log="/var/log/${app}/${service_name}-${app}.log"
done

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting systemd services..."

for service_name in "${SERVICES_LIST[@]}"; do
    ynh_systemctl --service="${app}-${service_name}" --action="start"
done

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
