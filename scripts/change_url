#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping systemd services..."

for service_name in "${SERVICES_LIST[@]}"; do
    ynh_systemctl --service="${app}-${service_name}" --action="stop"
done

#=================================================
# MODIFY URL IN NGINX CONF
#=================================================
ynh_script_progression "Updating NGINX web server configuration..."

ynh_config_change_url_nginx
if [ "$new_path" = "/" ]; then
    sed -i "s|location //|location /|g; s|__PATH__/|/|g; s|__PATH__|/|g" "/etc/nginx/conf.d/$new_domain.d/$app.conf"
fi

#=================================================
# UPDATE CONFIGURATION
#=================================================
ynh_script_progression "Updating $app configuration..."

new_document_url=$(append_uri "https://${new_domain}${new_path}" "docs")
ynh_app_setting_set --key=document_url --value="$new_document_url"
document_url="$new_document_url"

# Update env file with new domain/path-dependent values
domain="$new_domain"
path="$new_path"
ynh_config_add --template=".env" --destination="$install_dir/.env"

# Re-render dashboard and host runtime configuration
render_dashboard_config
render_host_config
patch_web_base_href

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting systemd services..."

for service_name in "${SERVICES_LIST[@]}"; do
    ynh_systemctl --service="${app}-${service_name}" --action="start"
done

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Change of URL completed for $app"
